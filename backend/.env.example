# Copy to backend/.env and adjust. Values here override your system environment.

# Storage: in-memory needs no database (data resets on restart). Set to false to use MongoDB.
USE_IN_MEMORY_DB=true
MONGO_URL=mongodb://localhost:27017
MONGODB_DB=algo-trade-simulator

# Enables POST /dev/auth/bypass so the frontend can log in automatically during development.
ENABLE_DEV_ENDPOINTS=true

# Chatbot (optional). Without a key the built-in market analyst answers instead.
GOOGLE_API_KEY=
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
# GEMINI_BUDGET_SECONDS=12

# Backtesting
# BACKTEST_PERIOD=2y
# TRADING_FEE_BPS=10

FRONTEND_ORIGIN=http://localhost:5173
