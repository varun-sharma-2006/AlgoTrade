# Copy to backend/.env and adjust. Values here override your system environment.

# Storage: in-memory needs no database (data resets on restart). Set to false to use MongoDB.
USE_IN_MEMORY_DB=true
MONGO_URL=mongodb://localhost:27017
MONGODB_DB=algo-trade-simulator

# Enables POST /dev/auth/bypass so the frontend can log in automatically during development.
ENABLE_DEV_ENDPOINTS=true

# Signs in-memory session tokens. Use a long random value in any deployment.
# SESSION_SECRET=change-me

# Sign in with Google (optional). Create a Web OAuth client at console.cloud.google.com.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# ADMIN_EMAILS=you@gmail.com

# Chatbot (optional). Without a key the built-in market analyst answers instead.
GOOGLE_API_KEY=
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
# GEMINI_BUDGET_SECONDS=12

# Backtesting
# BACKTEST_PERIOD=2y
# TRADING_FEE_BPS=10
# SLIPPAGE_BPS=5
# EXECUTION=next_open          # or "close"
# RISK_FREE_RATE=0.04
# BORROW_BPS=50                # annual cost of shorting
# INDIA_BROKERAGE_BPS=0        # NSE/BSE taxes and charges are added automatically
# BASE_CURRENCY=USD

# Daily trade alerts (/cron/daily). The job only runs with a CRON_SECRET.
# CRON_SECRET=change-me
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=app-password
# SMTP_FROM=you@gmail.com
# TELEGRAM_BOT_TOKEN=123456:ABC...

FRONTEND_ORIGIN=http://localhost:5173
